# Same Postgres instance the `butter` repo uses — this app reads listings
# and writes buyer_interest rows against the same database.
DATABASE_URL=

NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Where the seller login/workbench live — cross-domain links only,
# this app never renders those pages itself.
NEXT_PUBLIC_LOGIN_URL=https://login.trybutter.ai
NEXT_PUBLIC_APP_URL=https://app.trybutter.ai

NEXT_PUBLIC_SITE_URL=https://marketplace.trybutter.ai
